{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.parity\" && date +%s > \"$CLAUDE_PROJECT_DIR/.parity/session-start\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.parity\" && date +%s > \"$CLAUDE_PROJECT_DIR/.parity/session-end\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf 'PARITY_STATUSLINE'"
  }
}
